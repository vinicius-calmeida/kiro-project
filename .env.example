# Exemplo de variáveis de ambiente — versionado SEM valores (Req. 13.1).
# Copie para .env (ignorado pelo Git) e preencha localmente.

# Acesso ao serviço STAC do BDC (ADR-001)
BDC_ACCESS_TOKEN=

# Acesso ao bucket S3 obrigatório (ADR-011)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
EERA_S3_BUCKET=
